<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application android:label="Mirri" android:icon="@drawable/mirri_icon" android:usesCleartextTraffic="false">
        <!-- The host requires this tablet's exact landscape 2456x1600 display; Android 16 may ignore the orientation request. Runtime mode/surface validation rejects an incompatible surface. -->
        <activity android:name=".MainActivity" android:theme="@android:style/Theme.Material.NoActionBar" android:exported="true" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden" tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
